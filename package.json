{
  "name": "strapi-plugin-audit-log",
  "version": "1.1.0",
  "description": "Audit logging for Strapi v5. Content create/update/delete/publish/unpublish with field-level diffs and a per-widget before/after view of dynamic zones, plus logins, failed logins, logouts, denied requests and admin user/role/permission/media changes — all from Strapi Community Edition events. RBAC-protected admin UI, redaction, retention and structured-log forwarding.",
  "keywords": [
    "strapi",
    "plugin",
    "strapi-plugin",
    "audit",
    "audit-log",
    "audit-trail",
    "history",
    "compliance",
    "diff",
    "rbac",
    "security",
    "login",
    "siem",
    "vapt"
  ],
  "license": "MIT",
  "author": "Latheefwac",
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/sdk-plugin": "^6.0.0",
    "@strapi/strapi": "^5.0.0",
    "@strapi/typescript-utils": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-intl": "^6.6.0",
    "react-router-dom": "^6.28.0",
    "styled-components": "^6.1.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-intl": "^6.0.0 || ^7.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "audit-log",
    "displayName": "Audit Logs",
    "description": "Automatic audit logging with field-level diffs and an RBAC-protected admin UI."
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Latheefwac/strapi-cms-audit-logs.git"
  },
  "bugs": {
    "url": "https://github.com/Latheefwac/strapi-cms-audit-logs.git/issues"
  },
  "homepage": "https://github.com/Latheefwac/strapi-cms-audit-logs.git#readme"
}
